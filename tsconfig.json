{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": false, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vitest/globals"], "noEmit": true
  },
  "include": ["src"]
}
